--- CCLib_proxy.ino.orig
+++ CCLib_proxy.ino
@@ -35,10 +35,10 @@
 ////////////////////////////////////////
 
 // Pinout configuration (Configured for Arduino Leonardo)
-int CC_RST   = 5;
-int CC_DC    = 4;
-int CC_DD_I  = 3;
-int CC_DD_O  = 2;
+int CC_RST   = 5;   // D1
+int CC_DC    = 4;   // D2
+int CC_DD_I  = 14;  // D5
